{
  "manifest_version": 3,
  "name": "Mermove for GitHub",
  "version": "0.1.0",
  "description": "Pan and zoom Mermaid diagrams rendered on GitHub.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://viewscreen.githubusercontent.com/markdown/mermaid*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content-script.js"
      ]
    }
  ]
}
